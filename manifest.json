{
  "manifest_version": 3,
  "name": "YouTube Transcript Summarizer",
  "version": "0.1.0",
  "description": "Fetches YouTube transcripts, chunks them, and summarizes them using ChatGPT.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "webNavigation",
    "tabs",
    "downloads"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.youtube.com/watch*"],
      "js": ["content_scripts/youtube_transcript_fetcher.js"],
      "css": []
    },
    {
      "matches": ["https://chat.openai.com/*"],
      "js": ["content_scripts/chatgpt_interactor.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "ui/popup.html",
    "default_title": "YouTube Summarizer"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
